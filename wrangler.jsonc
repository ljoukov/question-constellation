{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "question-constellation",
	"compatibility_date": "2026-05-23",
	"compatibility_flags": ["nodejs_compat"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare",
		"not_found_handling": "404-page",
		"run_worker_first": true
	},
	"vars": {
		"CHATGPT_RESPONSES_WEBSOCKET_MODE": "off",
		"ANALYTICS_ENVIRONMENT": "production"
	},
	"d1_databases": [
		{
			"binding": "QUESTION_DB",
			"database_name": "question-constellation",
			"database_id": "1a344d0a-25ed-4e05-8d2e-b787d75a63cd",
			"migrations_dir": "migrations"
		},
		{
			"binding": "PERSONAL_DB",
			"database_name": "question-constellation-personal",
			"database_id": "7ee64a86-878b-4d18-b65d-9ff843b137c8",
			"migrations_dir": "migrations/personal"
		},
		{
			"binding": "ANALYTICS_DB",
			"database_name": "question-constellation-analytics",
			"database_id": "7f7d15d6-62e9-45b9-bbde-b30836a97e01",
			"migrations_dir": "migrations/analytics"
		}
	],
	"r2_buckets": [
		{
			"binding": "QUESTION_R2",
			"bucket_name": "question-constellation"
		}
	],
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": true
		}
	},
	"workers_dev": true,
	"preview_urls": true
}
